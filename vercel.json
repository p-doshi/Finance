{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "app", "format": "url", "env": "APP_URL" }
      ]
    },
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "app.py"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
